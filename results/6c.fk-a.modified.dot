digraph FKA {
  rankdir=TB;
  graph [fontname="Helvetica", labelloc="t", label="6c  (FK-A, structure view)"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#888888"];
  n1 [label="Node 1\nnC=8  nD=2\nsplit v3", fillcolor="#ffffff"];
  n2 [label="Node 2\nnC=4  nD=2\nsplit v5", fillcolor="#ffffff"];
  n3 [label="Node 3\nnC=0  nD=1\ntrivial", fillcolor="#eaf3ef"];
