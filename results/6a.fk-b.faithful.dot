digraph FKB {
  rankdir=TB;
  graph [fontname="Helvetica", labelloc="t", label="6a  (FK-B, structure view)"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#888888"];
  n1 [label="Node 1\nnC=4  nD=4\nsplit v1", fillcolor="#ffffff"];
  n2 [label="Node 2\nnC=3  nD=2\neasy_case", fillcolor="#eaf3ef"];
  n3 [label="Node 3\nnC=2  nD=3\neasy_case", fillcolor="#eaf3ef"];
  n1 -> n2 [label="x=0", style=solid];
  n1 -> n3 [label="x=1", style=dashed];
}
