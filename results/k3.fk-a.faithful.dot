digraph FKA {
  rankdir=TB;
  graph [fontname="Helvetica", labelloc="t", label="k3  (FK-A, structure view)"];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#888888"];
  n1 [label="Node 1\nnC=3  nD=3\nsplit v1", fillcolor="#ffffff"];
  n2 [label="Node 2\nnC=1  nD=2\nsplit v2", fillcolor="#ffffff"];
  n3 [label="Node 3\nnC=0  nD=1\ntrivial", fillcolor="#eaf3ef"];
  n4 [label="Node 4\nnC=1  nD=1\ntrivial", fillcolor="#eaf3ef"];
  n5 [label="Node 5\nnC=1  nD=2\nsplit v2", fillcolor="#ffffff"];
  n6 [label="Node 6\nnC=0  nD=1\ntrivial", fillcolor="#eaf3ef"];
  n7 [label="Node 7\nnC=1  nD=1\ntrivial", fillcolor="#eaf3ef"];
  n1 -> n2 [label="L", style=solid];
  n1 -> n5 [label="R", style=dashed];
  n2 -> n3 [label="L", style=solid];
  n2 -> n4 [label="R", style=dashed];
  n5 -> n6 [label="L", style=solid];
  n5 -> n7 [label="R", style=dashed];
}
