* text=auto
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.dot text eol=lf
Dockerfile text eol=lf
*.pdf binary
*.ipynb text eol=lf

# Third-party snapshot: stored byte-exact, with no line-ending conversion in
# either direction, so "unmodified" stays a checkable claim and its Makefile
# and CMake files reach a Linux build the way upstream shipped them.
Dedekind/** -text
